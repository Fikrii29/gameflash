{
  "version": 2,
  "builds": [
    {
      "src": "api/tokopay.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/otp.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/tokopay",
      "dest": "/api/tokopay.js"
    },
    {
      "src": "/api/otp",
      "dest": "/api/otp.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}